<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "setup": paste into the QUADmapper project in SignPath.
     The upload is the zip that actions/upload-artifact makes around
     QUADmapper-Setup-<version>.exe (.github/workflows/release.yml). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="QUADmapper-Setup-${version}.exe" product-name="QUADmapper" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
