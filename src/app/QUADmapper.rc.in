// The program icon and the version shown in Explorer (Properties > Details).
// Configured by src/app/CMakeLists.txt from project(VERSION).
#include <winver.h>

// GLFW_ICON is the name GLFW looks up for its windows' icon; Explorer shows it too.
GLFW_ICON ICON "@QUADMAPPER_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Fiavaion"
            VALUE "FileDescription", "QUADmapper projection mapping"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "QUADmapper"
            VALUE "LegalCopyright", "Copyright (c) 2026 Fiavaion. MIT License."
            VALUE "OriginalFilename", "QUADmapper.exe"
            VALUE "ProductName", "QUADmapper"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
