{
  "version": "1.0.0",
  "description": "Sub-agent automatic spawning rules for QUADmapper development",

  "agentNamingConvention": "Agent-{Phase}-{Component}[-{Subcomponent}]",

  "phases": {
    "phase1": {
      "name": "Core Foundation",
      "tasks": ["QM-001", "QM-002", "QM-003", "QM-004", "QM-005", "QM-006", "QM-007"],
      "sequential": true
    },
    "phase2": {
      "name": "Mesh & Multi-Quad",
      "tasks": ["QM-008", "QM-009", "QM-010", "QM-011", "QM-012", "QM-013"],
      "sequential": false,
      "dependsOn": ["phase1"]
    },
    "phase3": {
      "name": "Video Playback",
      "tasks": ["QM-014", "QM-015", "QM-016", "QM-017", "QM-018", "QM-019"],
      "sequential": true,
      "dependsOn": ["phase2"]
    },
    "phase4": {
      "name": "Multi-Output",
      "tasks": ["QM-020", "QM-021", "QM-022", "QM-023"],
      "sequential": true,
      "dependsOn": ["phase3"],
      "parallelWith": ["phase5", "phase6"]
    },
    "phase5": {
      "name": "Scene System",
      "tasks": ["QM-024", "QM-025", "QM-026", "QM-027"],
      "sequential": true,
      "dependsOn": ["phase3"],
      "parallelWith": ["phase4", "phase6"]
    },
    "phase6": {
      "name": "Audio System",
      "tasks": ["QM-028", "QM-029", "QM-030", "QM-031"],
      "sequential": true,
      "dependsOn": ["phase3"],
      "parallelWith": ["phase4", "phase5"]
    },
    "phase7": {
      "name": "Polish",
      "tasks": ["QM-032", "QM-033", "QM-034", "QM-035", "QM-036", "QM-037", "QM-038", "QM-039", "QM-040", "QM-041", "QM-042", "QM-043", "QM-044"],
      "sequential": false,
      "dependsOn": ["phase4", "phase5", "phase6"]
    }
  },

  "rules": [
    {
      "id": "rule-001",
      "trigger": "project_start",
      "condition": "no_active_agents",
      "spawn": ["Agent-Build"],
      "description": "Start with build system setup"
    },
    {
      "id": "rule-002",
      "trigger": "Agent-Build.complete",
      "spawn": ["Agent-P1-Renderer"],
      "description": "Begin Phase 1 with renderer foundation"
    },
    {
      "id": "rule-003",
      "trigger": "Agent-P1-Renderer.opengl_ready",
      "spawn": ["Agent-P1-Texture", "Agent-P1-UI"],
      "parallel": true,
      "description": "Parallelize texture and UI once OpenGL is ready"
    },
    {
      "id": "rule-004",
      "trigger": "Agent-P1-Renderer.quad_rendering_complete",
      "spawn": ["Agent-P1-Project"],
      "description": "Start project save/load after quad works"
    },
    {
      "id": "rule-005",
      "trigger": {
        "all": [
          "Agent-P1-Renderer.complete",
          "Agent-P1-Texture.complete",
          "Agent-P1-UI.complete",
          "Agent-P1-Project.complete"
        ]
      },
      "spawn": ["Agent-P1-Integration"],
      "description": "Integration testing for Phase 1"
    },
    {
      "id": "rule-006",
      "trigger": "Agent-P1-Integration.passed",
      "spawn": ["Agent-P2-Mesh", "Agent-P2-QuadManager"],
      "parallel": true,
      "description": "Start Phase 2 with parallel mesh and quad manager"
    },
    {
      "id": "rule-007",
      "trigger": "Agent-P2-Mesh.subdivision_working",
      "spawn": ["Agent-P2-UV"],
      "description": "UV controls after mesh basics work"
    },
    {
      "id": "rule-008",
      "trigger": {
        "all": [
          "Agent-P2-Mesh.complete",
          "Agent-P2-QuadManager.complete",
          "Agent-P2-UV.complete"
        ]
      },
      "spawn": ["Agent-P2-Integration"],
      "description": "Integration testing for Phase 2"
    },
    {
      "id": "rule-009",
      "trigger": "Agent-P2-Integration.passed",
      "spawn": ["Agent-P3-FFmpeg"],
      "description": "Start video decoder after Phase 2"
    },
    {
      "id": "rule-010",
      "trigger": "Agent-P3-FFmpeg.decoder_interface_ready",
      "spawn": ["Agent-P3-Playback"],
      "description": "Playback controls after decoder interface"
    },
    {
      "id": "rule-011",
      "trigger": "Agent-P3-Playback.state_machine_working",
      "spawn": ["Agent-P3-Timeline"],
      "description": "Timeline sync after playback works"
    },
    {
      "id": "rule-012",
      "trigger": {
        "all": [
          "Agent-P3-FFmpeg.complete",
          "Agent-P3-Playback.complete",
          "Agent-P3-Timeline.complete"
        ]
      },
      "spawn": ["Agent-P3-Integration"],
      "description": "Integration testing for Phase 3"
    },
    {
      "id": "rule-013",
      "trigger": "Agent-P3-Integration.passed",
      "spawn": ["Agent-P4-Output", "Agent-P5-Scene", "Agent-P6-AudioDecoder"],
      "parallel": true,
      "description": "Phases 4, 5, 6 can run in parallel"
    },
    {
      "id": "rule-014",
      "trigger": "Agent-P6-AudioDecoder.decoder_ready",
      "spawn": ["Agent-P6-AudioMixer"],
      "description": "Mixer after audio decoding works"
    },
    {
      "id": "rule-015",
      "trigger": {
        "all": [
          "Agent-P4-Output.complete",
          "Agent-P5-Scene.complete",
          "Agent-P6-AudioMixer.complete"
        ]
      },
      "spawn": ["Agent-P7-Shortcuts", "Agent-P7-Preferences", "Agent-P7-UI"],
      "parallel": true,
      "description": "Start Phase 7 polish in parallel"
    },
    {
      "id": "rule-016",
      "trigger": {
        "all": [
          "Agent-P7-Shortcuts.complete",
          "Agent-P7-Preferences.complete",
          "Agent-P7-UI.complete"
        ]
      },
      "spawn": ["Agent-P7-Performance"],
      "description": "Performance optimization after UI complete"
    },
    {
      "id": "rule-017",
      "trigger": "Agent-P7-Performance.complete",
      "spawn": ["Agent-P7-Testing", "Agent-P7-QA"],
      "parallel": true,
      "description": "Final testing phase"
    }
  ],

  "agentDefinitions": {
    "Agent-Build": {
      "tasks": ["QM-001"],
      "description": "CMake build system setup and verification"
    },
    "Agent-P1-Renderer": {
      "tasks": ["QM-002", "QM-003", "QM-004"],
      "description": "GLFW window, OpenGL context, basic quad rendering"
    },
    "Agent-P1-Texture": {
      "tasks": ["QM-005"],
      "description": "Image loading with stb_image"
    },
    "Agent-P1-UI": {
      "tasks": ["QM-006"],
      "description": "ImGui setup and inspector panel"
    },
    "Agent-P1-Project": {
      "tasks": ["QM-007"],
      "description": "Project save/load with JSON"
    },
    "Agent-P2-Mesh": {
      "tasks": ["QM-008", "QM-009"],
      "description": "Mesh subdivision and vertex editing"
    },
    "Agent-P2-QuadManager": {
      "tasks": ["QM-010", "QM-011", "QM-012"],
      "description": "Multiple quads, groups, z-order"
    },
    "Agent-P2-UV": {
      "tasks": ["QM-013"],
      "description": "UV offset/scale/crop controls"
    },
    "Agent-P3-FFmpeg": {
      "tasks": ["QM-014", "QM-015"],
      "description": "Video decoding and texture binding"
    },
    "Agent-P3-Playback": {
      "tasks": ["QM-016", "QM-017", "QM-018"],
      "description": "Playback controls, speed, loops"
    },
    "Agent-P3-Timeline": {
      "tasks": ["QM-019"],
      "description": "Timeline lock synchronization"
    },
    "Agent-P4-Output": {
      "tasks": ["QM-020", "QM-021", "QM-022", "QM-023"],
      "description": "Multi-output windows and perform mode"
    },
    "Agent-P5-Scene": {
      "tasks": ["QM-024", "QM-025", "QM-026", "QM-027"],
      "description": "Scene management and switching"
    },
    "Agent-P6-AudioDecoder": {
      "tasks": ["QM-028"],
      "description": "Audio extraction from video"
    },
    "Agent-P6-AudioMixer": {
      "tasks": ["QM-029", "QM-030", "QM-031"],
      "description": "Audio mixing and routing"
    },
    "Agent-P7-Shortcuts": {
      "tasks": ["QM-032"],
      "description": "Keyboard shortcut system"
    },
    "Agent-P7-Preferences": {
      "tasks": ["QM-033", "QM-034"],
      "description": "Preferences dialog and undo/redo"
    },
    "Agent-P7-UI": {
      "tasks": ["QM-035", "QM-036", "QM-037"],
      "description": "Media bin, preview, output panels"
    },
    "Agent-P7-Performance": {
      "tasks": ["QM-038", "QM-039"],
      "description": "Optimization and error handling"
    },
    "Agent-P7-Testing": {
      "tasks": ["QM-040", "QM-041", "QM-042", "QM-043"],
      "description": "Unit and integration tests"
    },
    "Agent-P7-QA": {
      "tasks": ["QM-044"],
      "description": "Manual testing protocols"
    }
  }
}
